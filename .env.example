# Reseñas públicas: proyecto Supabase configurado en content/supabase.json (solo valores públicos).
# Sobrescrituras opcionales; nunca pongas una secret/service_role key en VITE_.
# VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Para conservar el backend Node anterior en desarrollo:
# VITE_REVIEWS_PROVIDER=node

# El usuario y el hash existen solo en el servidor. Nunca uses prefijo VITE_ para secretos.
ADMIN_USER=
# Genera el hash con: npm run admin:password
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD se admite únicamente en desarrollo para compatibilidad; producción exige hash.
PORT=3001
# HOST=0.0.0.0
# NODE_ENV=production
# PUBLIC_ORIGIN=https://nicolasopazo7.github.io
# TRUST_PROXY=1 solo si hay exactamente un proxy HTTPS de confianza delante.
# DATA_DIR=/ruta/persistente/vibrados
# Solo para compilar Pages: URL pública del servidor, sin /api ni credenciales.
# VITE_REVIEWS_API_URL=https://api.tu-dominio.cl
