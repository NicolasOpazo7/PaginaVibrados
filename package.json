{
  "name": "vibrados-lagunilla",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --env-file-if-exists=.env server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --experimental-test-isolation=none server/*.test.js",
    "test:integration": "node server/integration-check.js",
    "test:components": "node scripts/component-tests.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "sql.js": "^1.13.0",
    "multer": "^2.0.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "vite": "^6.0.5",
    "typescript": "^5.7.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.19.0",
    "@eslint/js": "^9.17.0",
    "globals": "^15.14.0"
  }
}
